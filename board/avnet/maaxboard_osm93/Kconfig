if TARGET_MAAXBOARD_OSM93

config SYS_BOARD
	default "maaxboard_osm93"

config SYS_VENDOR
	default "avnet"

config SYS_CONFIG_NAME
	default "maaxboard_osm93"

config IMX93_EVK_LPDDR4X
	bool "Using LPDDR4X Timing and PMIC voltage"
	default y
	select IMX9_LPDDR4X
	help
	  Select the LPDDR4X timing and 0.6V VDDQ

config CMD_BOARDINFO
    bool "Enable BOARDINFO command in U-Boot"
    default y
    help
      Whether to enable the addition of the BOARDINFO command in U-Boot.

endif
